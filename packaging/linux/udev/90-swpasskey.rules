# swpasskey: virtual FIDO HID authenticator (UHID). Install to
# /etc/udev/rules.d/ then `udevadm control --reload-rules && udevadm trigger`.
#
# Only UHID + our hidraw node are touched. TPM nodes (/dev/tpmrm*) are owned
# by the distro's TPM udev rules (GROUP=tss); we deliberately do NOT retag them.

# Allow the active seat to create the virtual HID device.
KERNEL=="uhid", SUBSYSTEM=="misc", TAG+="uaccess", GROUP="plugdev", MODE="0660"

# Our virtual FIDO device. A UHID device has no USB parent (no idVendor /
# idProduct attributes); match the HID parent's kernel name
# "0003:1209:F1D0.NNNN" (bus:vid:pid). systemd's fido_id also sets
# ID_FIDO_TOKEN=1 + uaccess from the 0xF1D0 usage page for seated logins;
# the plugdev group covers headless / SSH sessions.
KERNEL=="hidraw*", SUBSYSTEMS=="hid", KERNELS=="0003:1209:F1D0.*", TAG+="uaccess", GROUP="plugdev", MODE="0660"
